<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.IdleOrderStatusLogMapper">

    <resultMap type="IdleOrderStatusLog" id="IdleOrderStatusLogResult">
        <id     property="logId"        column="log_id"        />
        <result property="orderId"      column="order_id"      />
        <result property="orderNo"      column="order_no"      />
        <result property="fromStatus"   column="from_status"   />
        <result property="toStatus"     column="to_status"     />
        <result property="operatorId"   column="operator_id"   />
        <result property="operatorName" column="operator_name" />
        <result property="operatorRole" column="operator_role" />
        <result property="remark"       column="remark"        />
        <result property="createTime"   column="create_time"   />
    </resultMap>

    <sql id="selectIdleOrderStatusLogVo">
        select log_id, order_id, order_no, from_status, to_status,
               operator_id, operator_name, operator_role, remark, create_time
        from idle_order_status_log
    </sql>

    <select id="selectStatusLogByOrderId" parameterType="Long" resultMap="IdleOrderStatusLogResult">
        <include refid="selectIdleOrderStatusLogVo"/>
        where order_id = #{orderId}
        order by log_id asc
    </select>

    <insert id="insertIdleOrderStatusLog" parameterType="IdleOrderStatusLog" useGeneratedKeys="true" keyProperty="logId">
        insert into idle_order_status_log
        (order_id, order_no, from_status, to_status, operator_id, operator_name, operator_role, remark, create_time)
        values
        (#{orderId}, #{orderNo}, #{fromStatus}, #{toStatus}, #{operatorId}, #{operatorName}, #{operatorRole}, #{remark}, #{createTime})
    </insert>

    <delete id="deleteIdleOrderStatusLogByOrderIds">
        delete from idle_order_status_log where order_id in
        <foreach item="orderId" collection="orderIds" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>
</mapper>
