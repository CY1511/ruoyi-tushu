<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.OrderItemMapper">

    <resultMap type="OrderItem" id="OrderItemResult">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="bookId" column="book_id"/>
        <result property="title" column="title"/>
        <result property="coverImage" column="cover_image"/>
        <result property="price" column="price"/>
        <result property="quantity" column="quantity"/>
        <result property="condition" column="condition"/>
    </resultMap>

    <select id="selectOrderItemByOrderId" parameterType="Long" resultMap="OrderItemResult">
        select * from order_item where order_id = #{orderId}
    </select>

    <insert id="insertOrderItem" parameterType="OrderItem" useGeneratedKeys="true" keyProperty="id">
        insert into order_item(order_id, book_id, title, cover_image, price, quantity, `condition`)
        values(#{orderId}, #{bookId}, #{title}, #{coverImage}, #{price}, #{quantity}, #{condition})
    </insert>

    <insert id="insertOrderItems" parameterType="list">
        insert into order_item(order_id, book_id, title, cover_image, price, quantity, `condition`)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.bookId}, #{item.title}, #{item.coverImage}, #{item.price}, #{item.quantity}, #{item.condition})
        </foreach>
    </insert>

    <delete id="deleteOrderItemByOrderId" parameterType="Long">
        delete from order_item where order_id = #{orderId}
    </delete>

</mapper>