<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.UserMapper">

    <resultMap id="UserResult" type="com.ruoyi.system.domain.User">
        <id property="id" column="id"/>
        <result property="phone" column="phone"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="schoolName" column="school_name"/>
        <result property="studentId" column="student_id"/>
        <result property="department" column="department"/>
        <result property="balance" column="balance"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectUserById" parameterType="Long" resultMap="UserResult">
        select * from user where id = #{userId}
    </select>

    <select id="selectUserByUserName" parameterType="String" resultMap="UserResult">
        select * from user where nickname = #{userName}
    </select>

    <select id="selectUserByPhone" parameterType="String" resultMap="UserResult">
        select * from user where phone = #{phone}
    </select>

    <select id="selectUserList" parameterType="com.ruoyi.system.domain.User" resultMap="UserResult">
        select * from user
        <where>
            <if test="phone != null">and phone like concat('%', #{phone}, '%')</if>
            <if test="nickname != null">and nickname like concat('%', #{nickname}, '%')</if>
            <if test="status != null">and status = #{status}</if>
        </where>
    </select>

    <insert id="insertUser" parameterType="com.ruoyi.system.domain.User" useGeneratedKeys="true" keyProperty="id">
        insert into user (phone, password, nickname, avatar, school_name, student_id, department, balance, status, created_at, updated_at)
        values (#{phone}, #{password}, #{nickname}, #{avatar}, #{schoolName}, #{studentId}, #{department}, #{balance}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="updateUser" parameterType="com.ruoyi.system.domain.User">
        update user
        <set>
            <if test="phone != null">phone = #{phone},</if>
            <if test="password != null">password = #{password},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="schoolName != null">school_name = #{schoolName},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="department != null">department = #{department},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteUserById" parameterType="Long">
        delete from user where id = #{userId}
    </delete>

</mapper>