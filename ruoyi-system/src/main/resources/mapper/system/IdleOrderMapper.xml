<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.IdleOrderMapper">
    
    <resultMap type="IdleOrder" id="IdleOrderResult">
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="sellerId"    column="seller_id"    />
        <result property="buyerId"    column="buyer_id"    />
        <result property="orderPrice"    column="order_price"    />
        <result property="orderStatus"    column="order_status"    />
        <result property="finishTime"    column="finish_time"    />
        <result property="cancelReason"    column="cancel_reason"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectIdleOrderVo">
        select order_id, order_no, goods_id, seller_id, buyer_id, order_price, order_status, finish_time, cancel_reason, remark, create_by, create_time, update_by, update_time from idle_order
    </sql>

    <select id="selectIdleOrderList" parameterType="IdleOrder" resultMap="IdleOrderResult">
        <include refid="selectIdleOrderVo"/>
        <where>  
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="sellerId != null "> and seller_id = #{sellerId}</if>
            <if test="buyerId != null "> and buyer_id = #{buyerId}</if>
            <if test="orderPrice != null "> and order_price = #{orderPrice}</if>
            <if test="orderStatus != null  and orderStatus != ''"> and order_status = #{orderStatus}</if>
            <if test="finishTime != null "> and finish_time = #{finishTime}</if>
            <if test="cancelReason != null  and cancelReason != ''"> and cancel_reason = #{cancelReason}</if>
        </where>
    </select>
    
    <select id="selectIdleOrderByOrderId" parameterType="Long" resultMap="IdleOrderResult">
        <include refid="selectIdleOrderVo"/>
        where order_id = #{orderId}
    </select>

    <insert id="insertIdleOrder" parameterType="IdleOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into idle_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="sellerId != null">seller_id,</if>
            <if test="buyerId != null">buyer_id,</if>
            <if test="orderPrice != null">order_price,</if>
            <if test="orderStatus != null and orderStatus != ''">order_status,</if>
            <if test="finishTime != null">finish_time,</if>
            <if test="cancelReason != null">cancel_reason,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="sellerId != null">#{sellerId},</if>
            <if test="buyerId != null">#{buyerId},</if>
            <if test="orderPrice != null">#{orderPrice},</if>
            <if test="orderStatus != null and orderStatus != ''">#{orderStatus},</if>
            <if test="finishTime != null">#{finishTime},</if>
            <if test="cancelReason != null">#{cancelReason},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateIdleOrder" parameterType="IdleOrder">
        update idle_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="sellerId != null">seller_id = #{sellerId},</if>
            <if test="buyerId != null">buyer_id = #{buyerId},</if>
            <if test="orderPrice != null">order_price = #{orderPrice},</if>
            <if test="orderStatus != null and orderStatus != ''">order_status = #{orderStatus},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <delete id="deleteIdleOrderByOrderId" parameterType="Long">
        delete from idle_order where order_id = #{orderId}
    </delete>

    <delete id="deleteIdleOrderByOrderIds" parameterType="String">
        delete from idle_order where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

    <select id="countOrdersByUserId" parameterType="Long" resultType="int">
        select count(*) from idle_order where buyer_id = #{userId} or seller_id = #{userId}
    </select>
</mapper>