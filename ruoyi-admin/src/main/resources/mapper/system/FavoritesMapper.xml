<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.FavoritesMapper">

    <resultMap type="Favorites" id="FavoritesResult">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="bookId" column="book_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectFavoritesList" parameterType="Long" resultMap="FavoritesResult">
        select * from favorites where user_id = #{userId} order by create_time desc
    </select>

    <select id="selectFavoritesById" parameterType="Long" resultMap="FavoritesResult">
        select * from favorites where id = #{id}
    </select>

    <select id="selectFavoritesByUserBook" resultMap="FavoritesResult">
        select * from favorites where user_id = #{param1} and book_id = #{param2}
    </select>

    <insert id="insertFavorites" parameterType="Favorites" useGeneratedKeys="true" keyProperty="id">
        insert into favorites(user_id, book_id) values(#{userId}, #{bookId})
    </insert>

    <delete id="deleteFavoritesById" parameterType="Long">
        delete from favorites where id = #{id}
    </delete>

    <delete id="deleteFavoritesByUserBook">
        delete from favorites where user_id = #{param1} and book_id = #{param2}
    </delete>

    <select id="countFavorites" parameterType="Long" resultType="Integer">
        select count(*) from favorites where book_id = #{bookId}
    </select>

</mapper>