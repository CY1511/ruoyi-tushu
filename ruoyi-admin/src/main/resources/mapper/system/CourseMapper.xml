<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CourseMapper">

    <resultMap type="Course" id="CourseResult">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="department" column="department"/>
        <result property="university" column="university"/>
        <result property="credit" column="credit"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectCourseList" parameterType="Course" resultMap="CourseResult">
        select * from course
        <where>
            <if test="name != null and name != ''">name like concat('%', #{name}, '%')</if>
            <if test="code != null and code != ''">and code like concat('%', #{code}, '%')</if>
            <if test="department != null and department != ''">and department = #{department}</if>
            <if test="university != null and university != ''">and university = #{university}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectCourseById" parameterType="Long" resultMap="CourseResult">
        select * from course where id = #{id}
    </select>

    <insert id="insertCourse" parameterType="Course" useGeneratedKeys="true" keyProperty="id">
        insert into course(name, code, department, university, credit)
        values(#{name}, #{code}, #{department}, #{university}, #{credit})
    </insert>

    <update id="updateCourse" parameterType="Course">
        update course set
        <if test="name != null">name = #{name},</if>
        <if test="code != null">code = #{code},</if>
        <if test="department != null">department = #{department},</if>
        <if test="university != null">university = #{university},</if>
        <if test="credit != null">credit = #{credit},</if>
        update_time = now()
        where id = #{id}
    </update>

    <delete id="deleteCourseById" parameterType="Long">
        delete from course where id = #{id}
    </delete>

</mapper>